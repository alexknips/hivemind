# HiveMind self-hosted cell — environment variables
# Copy to .env and fill in values before running `docker compose up`.

# --- Required for production ---

# Admin bearer token for the POST /v1/tenants provisioning endpoint.
# Generate with: openssl rand -hex 32
HIVEMIND_ADMIN_KEY=change-me-before-production

# Postgres password for the bundled postgres service.
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=change-me-before-production

# --- Optional ---

# Port the HTTP API (and SPA) listens on inside the container.
# The default (8080) is published on the same host port.
# HIVEMIND_PORT=8080

# Host address the port is published on. Default 127.0.0.1: reachable only
# from this host. Set to a specific interface address (e.g. a tailnet IP) to
# expose the cell on that interface, or 0.0.0.0 for every interface. Prefer a
# TLS reverse proxy on the same host — see docs/SELF_HOSTING.md, "Exposing the
# cell deliberately".
# HIVEMIND_PUBLISH_ADDR=127.0.0.1

# Static bearer token for SQLite mode (only if you remove HIVEMIND_DATABASE_URL
# from docker-compose.yml). Generate with: openssl rand -hex 32
# HIVEMIND_API_KEY=

# Enable the Layer-3 ingest classifier (Claude Haiku).
# When set, captured decisions are automatically classified on write.
# ANTHROPIC_API_KEY=sk-ant-...

# Comma-separated origins allowed for browser cross-origin requests.
# Needed when your SPA is served from a different origin than the API.
# Example: HIVEMIND_CORS_ORIGINS=https://app.example.com
# HIVEMIND_CORS_ORIGINS=

# Host port for direct Postgres access from local CLI/MCP agents. Only used
# with docker-compose.local-agents.yml (not applied by default); see
# docs/SELF_HOSTING.md, "Using the CLI / MCP from local agents".
# POSTGRES_PORT=5432

# --- WorkOS (optional, for OIDC login — self-hosted cells typically omit this) ---
# See docs/SELF_HOSTING.md for the no-WorkOS auth story.
# WORKOS_DOMAIN=
# WORKOS_JWKS_URL=
# WORKOS_AUDIENCE=
