{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hivemind.local/schemas/v0/ingest.batch_classified.json",
  "title": "ingest.batch_classified event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_uuid", "type", "actor_id", "source", "payload"],
  "properties": {
    "event_id": { "type": ["integer", "null"], "minimum": 1 },
    "event_uuid": { "type": "string", "format": "uuid" },
    "correlation_id": { "type": ["string", "null"], "minLength": 1 },
    "causation_event_id": { "type": ["integer", "null"], "minimum": 1 },
    "type": { "const": "ingest.batch_classified" },
    "actor_id": { "type": "string", "minLength": 1 },
    "source": { "enum": ["cli", "agent", "human", "slack", "document", "api"] },
    "source_ref": { "type": ["string", "null"], "minLength": 1 },
    "ts": { "type": ["string", "null"], "format": "date-time" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "classifier_model", "schema_version", "captures"],
      "properties": {
        "batch_id": { "type": "string", "minLength": 1 },
        "classifier_model": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "batch_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "All batch ids this single classification call covers, in submission order. Omitted or empty on events predating session-grouped classification (hivemind-zdsh.18); readers fall back to batch_id."
        },
        "captures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "title", "rationale", "topic_keys", "evidence_ids", "options", "chosen_option", "extraction_confidence"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["decision", "evidence", "hypothesis", "blocker", "decision-request", "notification"]
              },
              "title": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string", "minLength": 1 },
              "topic_keys": {
                "type": "array",
                "items": { "type": "string" }
              },
              "evidence_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "options": {
                "oneOf": [
                  { "type": "array", "items": { "type": "string" } },
                  { "type": "null" }
                ]
              },
              "chosen_option": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "null" }
                ]
              },
              "extraction_confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
              "restates_id": {
                "type": "string",
                "minLength": 1,
                "description": "A decision capture only: the id of an already recorded decision this capture states again. It projects a SAME_AS link to that decision."
              },
              "source_turn_id": {
                "type": "string",
                "minLength": 1,
                "description": "The turn_id of the turn, in one of the batches this classification covers, that this capture came from: the turn that made the decision, or the turn that asked the question of a decision-request. The write path refuses an id that names no such turn."
              },
              "source_ts": {
                "type": "string",
                "format": "date-time",
                "description": "The time of the turn source_turn_id names, set by the write path from the received batch and never taken from the caller. A decision is recorded at this time in place of the classification's own. Absent when the capture names no turn or that turn carries no time."
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "description": "A decision or decision-request capture only: the question, in the words it was asked in. On a decision-request with a source turn that carries a time, one question.asked is written at that time. On a decision, the question it answers (ANSWERS), resolved by normalized text like capture --question."
              }
            }
          }
        }
      }
    }
  }
}
