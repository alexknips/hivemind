      "expressed_confidence": null,
      "id": "decision-4957760d-4511-430f-918e-b32cd5a69c70",
      "project": "ridewell-mobile",
      "project_source": "stated",
      "question": "How do we avoid blocking cold start on a profile fetch?",
      "quote": null,
      "rationale": "Cold start currently blocks on a profile fetch before the map can render. The API already treats driver_id as stable once assigned, so storing it in local device storage at login and reusing it on every cold start removes that fetch with no correctness cost.",
      "slug": "cache-the-driver-s-id-on-the-phone-at-login-and-skip-the-pro",
      "source": "agent",
      "source_ref": "agent:codex:ridewell-sync",
      "status": "accepted",
      "tenant_id": "local",
      "title": "Cache the driver's id on the phone at login and skip the profile lookup on cold start",
      "topic_keys": [
        "ridewell",
        "mobile"
      ]
    },
    {
      "decided_at": "2026-10-03T06:50:49.222292587+00:00",
      "deciders": [
        {
          "id": "human:maya",
          "kind": "human"
        }
      ],
      "event_origin": 63,
      "expressed_confidence": null,
      "id": "decision-9533f8d8-fd67-44ed-92cc-0ddbdf9e948d",
      "project": "ridewell-api",
      "project_source": "inherited",
      "question": null,
      "quote": null,
      "rationale": "The 2026-09-20 platform migration reassigned numeric driver ids for over a thousand accounts and briefly served two drivers each other's cached profile. The dispatch service already receives a separate UUID from the identity provider that survives a backend migration; keying the cache on that UUID removes the failure mode the numeric-id assumption depended on.",
      "slug": "cache-driver-profiles-keyed-by-a-stable-external-uuid-instea",
      "source": "human",
      "source_ref": "human:maya",
      "status": "accepted",
      "tenant_id": "local",
      "title": "Cache driver profiles keyed by a stable external UUID instead of the mutable numeric id",
      "topic_keys": [
        "infrastructure",
        "ridewell"
      ]
    },
