      "id": "decision-22b827cf-1b45-4dae-b07f-21720e6bded0",
      "project": "ridewell-api",
      "project_source": "stated",
      "question": "How do we avoid a database round trip on every dispatch lookup?",
      "quote": null,
      "rationale": "Driver-profile reads dominate dispatch-service load, about 70% of calls. An in-memory LRU keyed by driver_id avoids a database round trip on every dispatch and is simple to reason about, since driver_id is the primary key login already returns.",
      "slug": "cache-driver-profiles-in-memory-keyed-by-the-driver-s-numeri",
      "source": "human",
      "source_ref": "human:maya",
      "status": "superseded",
      "tenant_id": "local",
      "title": "Cache driver profiles in memory, keyed by the driver's numeric id",
      "topic_keys": [
        "infrastructure",
        "ridewell"
      ]
    },
    {
