      "id": "decision-f2b0c6a7-e651-4e91-938b-22f57e815627",
      "project": "trailkeeper",
      "project_source": "stated",
      "question": "Where do we store a hiker's trip logs?",
      "quote": "Let's not stand up a backend before we know anyone wants this.",
      "rationale": "TrailKeeper v1 is single-device: one hiker records one trip on one phone. SQLite needs no server, keeps the app fully usable with no signal on trail, and keeps hosting cost at zero while we find out if anyone wants this at all.",
      "slug": "store-hike-logs-in-local-sqlite-on-the-phone",
      "source": "human",
      "source_ref": "human:priya",
      "status": "superseded",
      "tenant_id": "local",
      "title": "Store hike logs in local SQLite on the phone",
      "topic_keys": [
        "infrastructure",
        "trailkeeper"
      ]
    },
    {
      "decided_at": "2026-10-03T06:50:47.716789684+00:00",
      "deciders": [
        {
          "id": "human:priya",
          "kind": "human"
        }
      ],
      "event_origin": 26,
      "expressed_confidence": null,
      "id": "decision-f2b18863-ec45-40da-a66d-bbd88e8687b3",
      "project": "trailkeeper",
      "project_source": "inherited",
      "question": null,
      "quote": null,
      "rationale": "The single-device assumption behind local SQLite doesn't hold: the beta survey shows most hikers already use TrailKeeper on their phone and the web dashboard, and a fifth of them lost photos or edits made on the other device. Postgres with a per-user sync log lets both surfaces read and write the same trip; we accept running one small managed instance in exchange for not losing anyone's trip again.",
      "slug": "move-hike-log-storage-to-a-hosted-postgres-synced-across-dev",
      "source": "human",
      "source_ref": "human:priya",
      "status": "accepted",
      "tenant_id": "local",
      "title": "Move hike log storage to a hosted Postgres, synced across devices",
      "topic_keys": [
        "infrastructure",
        "trailkeeper"
      ]
    }
