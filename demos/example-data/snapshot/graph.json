      "id": "decision-d72e92ef-7656-4bd4-b21e-fe62557e23ef",
      "project": "ridewell-mobile",
      "project_source": "stated",
      "question": null,
      "quote": null,
      "rationale": "Field logs from the last two weeks show sync failures during cell-tower handoff mostly clear within 4 attempts. A fixed short retry gives up too early on a flaky handoff; an unbounded retry can spin all day and drains the phone's battery mid-shift.",
      "slug": "retry-a-failed-location-ping-upload-up-to-5-times-with-expon",
      "source": "agent",
      "source_ref": "agent:claude:ridewell-mobile-ci",
      "status": "accepted",
      "tenant_id": "local",
      "title": "Retry a failed location-ping upload up to 5 times with exponential backoff, capped at 30 seconds",
      "topic_keys": [
        "ridewell",
        "mobile",
        "reliability"
      ]
    },
    {
      "decided_at": "2026-10-03T06:50:47.531014282+00:00",
