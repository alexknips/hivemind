      "project": "ridewell-mobile",
      "project_label": "Ridewell Mobile",
      "rationale": "Field logs from the last two weeks show sync failures during cell-tower handoff mostly clear within 4 attempts. A fixed short retry gives up too early on a flaky handoff; an unbounded retry can spin all day and drains the phone's battery mid-shift.",
      "rejected_options": [
        {
          "label": "Unlimited retries with a circuit breaker",
          "option_id": "option-2701e2b8-2796-4fe0-a2b7-1d7453217003"
        },
        {
          "label": "3 retries fixed 5s gap",
          "option_id": "option-ed212884-d10b-4e24-9a01-176123a0fd78"
        }
      ],
      "rests_on": [
        {
          "added": {
            "when": "at_capture"
          },
          "check_by": "2026-11-15T00:00:00Z",
          "id": "hypothesis-26ae9208-4a83-417a-8a29-1306e4ac107b",
          "kind": "bet",
          "label": "Capping at 5 retries with backoff will clear at least 90% of handoff failures without a manual retry",
          "overdue": false,
          "state": "open",
          "would_change_if": "Manual retry reports do not drop after this ships"
        }
      ],
      "slug": "retry-a-failed-location-ping-upload-up-to-5-times-with-expon",
      "status": "accepted",
