{
  "description": "Record an agent's AskUserQuestion as a HiveMind ask, and the human's answer as a decision linked to it.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/ask-hook.sh\" pre",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/ask-hook.sh\" post",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
